NODE_ENV=develop
# 절대 URL(http://192.168.10.182:48080/rest)이었으나, 배포된 페이지가 HTTPS로 서빙되면
# 이 http:// 요청들이 브라우저 Mixed Content 정책으로 전부 차단돼("Failed to load resource"
# 다수, KTDB 임포트 후 지도에 반영 안 됨의 원인) API 호출이 통째로 실패했다. iitp-front의
# nginx(default.conf)가 이미 /rest/ 를 같은 origin에서 백엔드로 프록시하므로, 상대 경로로
# 바꾸면 페이지가 http/https 어느 쪽으로 서빙되든 항상 같은 프로토콜로 요청된다.
VITE_API_URL=/rest

