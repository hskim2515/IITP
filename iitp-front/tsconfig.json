{
  "compilerOptions": {
    "allowJs": false,
    "checkJs": false, // JS 파일에 대한 타입 검사도 비활성화
    "noEmit": true,   // 빌드시 JS 파일이 생성되지 않도록 함
    "module": "ESNext",
    "target": "ESNext",
    "strict": true,
    "jsx": "react",
    "allowSyntheticDefaultImports": true,
    "baseUrl": "./",  // src 디렉토리를 기준으로 경로 설정
    "moduleResolution": "node",
    "moduleDetection": "force",
    "skipLibCheck": true,
    "paths": {
      "@primitives/*": ["src/primitives/*"],
      "@api/*": ["src/api/*"],
      "@config/*": ["src/config/*"],
      "@component/*": ["src/component/*"],
      "@stores/*": ["src/stores/*"],
      "@css/*": ["static/css/*"],
      "@schema/*": ["src/schema/*"],
      "@utils/*": ["src/utils/*"],
      "@adaptor/*": ["src/adaptor/*"],
      "@managers/*": ["src/managers/*"],
      "@features/*": ["src/features/*"],
      "@type/*": ["src/type/*"],
      "@hooks/*": ["src/hooks/*"]
    }
  },
  "exclude": ["node_modules", "**/*.js"] // JS 파일 제외
}