{
  "compilerOptions": {
    "allowJs": false,
    "checkJs": false, // JS 파일에 대한 타입 검사도 비활성화
    "noEmit": true,   // 빌드시 JS 파일이 생성되지 않도록 함
    "module": "ESNext",
    "target": "ESNext",
    "strict": true,
    "jsx": "react",
    "allowSyntheticDefaultImports": true,
    "baseUrl": "./",  // src 디렉토리를 기준으로 경로 설정
    "moduleResolution": "Bundler",
    "noUncheckedIndexedAccess": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "paths": {
      "@adaptor/*": ["src/adaptor/*"],
      "@api/*": ["src/api/*"],
      "@assets/*": ["src/assets/*"],
      "@component/*": ["src/component/*"],
      "@config/*": ["src/config/*"],
      "@datasource/*": ["src/datasource/*"],
      "@features/*": ["src/features/*"],
      "@interactions/*": ["src/interactions/*"],
      "@handler/*": ["src/handler/*"],
      "@hooks/*": ["src/hooks/*"],
      "@managers/*": ["src/managers/*"],
      "@primitives/*": ["src/primitives/*"],
      "@schema/*": ["src/schema/*"],
      "@stores/*": ["src/stores/*"],
      "@type/*": ["src/type/*"],
      "@utils/*": ["src/utils/*"],
      "@worker/*": ["src/worker/*"],
      "@css/*": ["static/css/*"],
    }
  },
  "exclude": ["node_modules", "**/*.js"] // JS 파일 제외
}